# 기존에 운영 중인 백엔드 플랫폼 주소로 교체 (비워두면 자동으로 목업 폴백)
EXPO_PUBLIC_API_BASE_URL=https://api.existing-platform.com
EXPO_PUBLIC_API_TIMEOUT_MS=10000
# PART 1.4.1 — 미지정 시 API 주소가 비어 있으면 목업, 있으면 실서버 사용
EXPO_PUBLIC_USE_MOCK_DATA=true
# 선택, 비워두면 비활성
EXPO_PUBLIC_SENTRY_DSN=
EAS_PROJECT_ID=

# --- 아래 3개는 CI(GitHub Actions)가 빌드 타임에 자동 주입 (수동 설정 불필요) ---
# PART 5.2 — OTA 업데이트 비교 기준(번들에 구워지는 값)
# EXPO_PUBLIC_BUILD_NUMBER=1
# EXPO_PUBLIC_APP_VERSION=1.0.0
# EXPO_PUBLIC_COMMIT_SHA=local
