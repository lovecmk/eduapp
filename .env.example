# ─────────────────────────────────────────────────────────────
# eduapp 프론트엔드 환경변수 예시
#
# 사용법:
#   • 이 파일을 `.env` 로 복사해 값을 채운다:  cp .env.example .env
#   • 개인용 로컬 오버라이드는 `.env.local` 에 둔다(.gitignore 에 의해 커밋 제외).
#   • 모든 변수는 반드시 `EXPO_PUBLIC_` 접두사가 있어야 번들에 인라인된다.
#   • 앱 내 "개발자 모드 > 환경 설정" 화면에서 현재 적용값을 확인할 수 있다.
#
# 주의: 여기 값들은 클라이언트 번들에 그대로 구워지므로 진짜 비밀키(서버 시크릿)는
#       절대 넣지 않는다. 서버 비밀은 서버 쪽 .env 에만 둔다
#       (KFPA 브릿지 저장소의 BE/.env — D3M_* 키들. BE/daily3min/README.md 참고).
# ─────────────────────────────────────────────────────────────

# 서버 주소 — KFPA 브릿지(kbwiki)다. 백엔드가 그 안에 얹혀 있다.
#
#  · 경로(/api)는 붙이지 않는다. ApiClient 가 모든 요청에 알아서 붙인다.
#  · 끝에 "/" 를 붙이지 말 것 — 경로가 "//inner/api/v1/..." 로 중복된다.
#  · 비워두면 자동으로 목업 폴백(서버 없이 화면만 볼 때).
#
# 운영:   https://bridge.kfpa.or.kr   (DMZ1 — 배포되는 앱은 이 주소만 본다)
# 테스트: http://test.inplat.org:8090 (사내망 전용 · 평문)
#
# 평문(http://) 주소로 빌드하면 app.config.js 가 **그 호스트 하나에 대해서만**
# 안드로이드 cleartext / iOS ATS 예외를 붙인다. 운영(https) 빌드에는 예외가 없다.
# 그래서 이 값은 "어디에 붙느냐"뿐 아니라 "네이티브 보안 설정"까지 결정한다.
EXPO_PUBLIC_API_BASE_URL=https://bridge.kfpa.or.kr

# 네트워크 요청 타임아웃(ms) — 권장 3000 이상
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# PART 1.4.1 — 미지정 시 API 주소가 비어 있으면 목업, 있으면 실서버 사용
# (true/false/1/0/yes/no 허용)
#
# 실서버에 붙일 때는 반드시 false 로 둔다. 주소만 채우고 이 값을 true 로 남겨 두면
# 앱은 조용히 목업으로 돌고, 화면은 멀쩡해 보이는데 아무것도 저장되지 않는다.
EXPO_PUBLIC_USE_MOCK_DATA=false

# 선택, 비워두면 비활성
EXPO_PUBLIC_SENTRY_DSN=
EAS_PROJECT_ID=

# 날씨 API 연동 슬롯 — 홈 배경 앰비언트(비/눈/맑음)용. 추후 연동 예정.
#  · 자체 백엔드가 GET /inner/api/v1/weather/current 로 프록시하면 아래는 비워둬도 됨(API_BASE_URL 사용).
#  · 서드파티(OpenWeather 등)를 직접 호출할 경우에만 키/기본 지역을 채운다.
#  · 비워두면 목업('맑음')으로 안전하게 폴백한다.
EXPO_PUBLIC_WEATHER_API_KEY=
EXPO_PUBLIC_WEATHER_REGION=Seoul

# --- 아래 3개는 CI(GitHub Actions)가 빌드 타임에 자동 주입 (수동 설정 불필요) ---
# PART 5.2 — OTA 업데이트 비교 기준(번들에 구워지는 값)
# EXPO_PUBLIC_BUILD_NUMBER=1
# EXPO_PUBLIC_APP_VERSION=1.0.0
# EXPO_PUBLIC_COMMIT_SHA=local
