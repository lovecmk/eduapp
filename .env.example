# ─────────────────────────────────────────────────────────────
# eduapp 프론트엔드 환경변수 예시
#
# 사용법:
#   • 이 파일을 `.env` 로 복사해 값을 채운다:  cp .env.example .env
#   • 개인용 로컬 오버라이드는 `.env.local` 에 둔다(.gitignore 에 의해 커밋 제외).
#   • 모든 변수는 반드시 `EXPO_PUBLIC_` 접두사가 있어야 번들에 인라인된다.
#   • 앱 내 "개발자 모드 > 환경 설정" 화면에서 현재 적용값을 확인할 수 있다.
#
# 주의: 여기 값들은 클라이언트 번들에 그대로 구워지므로 진짜 비밀키(서버 시크릿)는
#       절대 넣지 않는다. 서버 비밀은 backend/.env 에만 둔다.
# ─────────────────────────────────────────────────────────────

# 기존에 운영 중인 백엔드 플랫폼 주소로 교체 (비워두면 자동으로 목업 폴백)
# 끝에 "/" 를 붙이지 말 것 — 경로가 "//api/..." 로 중복된다.
EXPO_PUBLIC_API_BASE_URL=https://api.existing-platform.com

# 네트워크 요청 타임아웃(ms) — 권장 3000 이상
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# PART 1.4.1 — 미지정 시 API 주소가 비어 있으면 목업, 있으면 실서버 사용
# (true/false/1/0/yes/no 허용)
EXPO_PUBLIC_USE_MOCK_DATA=true

# 선택, 비워두면 비활성
EXPO_PUBLIC_SENTRY_DSN=
EAS_PROJECT_ID=

# --- 아래 3개는 CI(GitHub Actions)가 빌드 타임에 자동 주입 (수동 설정 불필요) ---
# PART 5.2 — OTA 업데이트 비교 기준(번들에 구워지는 값)
# EXPO_PUBLIC_BUILD_NUMBER=1
# EXPO_PUBLIC_APP_VERSION=1.0.0
# EXPO_PUBLIC_COMMIT_SHA=local
