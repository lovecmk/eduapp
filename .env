# 로컬 개발용 — 값 설명은 .env.example 참고.
#
# 백엔드는 KFPA 브릿지(kbwiki) 안에 얹혀 있다.
#
#   운영   https://bridge.kfpa.or.kr      ← DMZ1. 배포 APK/스토어 빌드는 반드시 이 값
#   테스트 http://test.inplat.org:8090    ← 사내망 전용(평문)
#
# 이 파일은 `npm start` 로 도는 로컬 개발에만 쓰인다. APK/EAS 빌드의 주소는
# eas.json 의 프로필 env 또는 GitHub Secrets 가 정한다(.env 를 덮어쓴다).
EXPO_PUBLIC_API_BASE_URL=http://test.inplat.org:8090
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_USE_MOCK_DATA=false
EXPO_PUBLIC_SENTRY_DSN=
