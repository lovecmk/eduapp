# 로컬 개발용 — 값 설명은 .env.example 참고.
#
# 백엔드는 KFPA 브릿지(kbwiki) 안에 얹혀 있다.
#
#   운영   https://bridge.kfpa.or.kr      ← DMZ1. 이 앱이 보는 서버는 이것 하나다.
#   테스트 http://test.inplat.org:8090    ← 사내망 전용(평문). 사내망 안에서 일시적으로
#                                           확인할 때만 손으로 바꿔 쓴다.
#
# 테스트 주소는 사내망 밖에서 DNS 조차 풀리지 않는다. 그 상태로 앱을 켜면 fetch 가
# 응답을 받지 못해(status 0) 화면에는 "네트워크에 연결할 수 없어요" 한 줄만 뜬다 —
# 서버는 멀쩡한데 원인을 서버에서 찾게 되는 실패다. 그래서 기본값은 운영으로 둔다.
#
# 이 파일은 `npm start` 로 도는 로컬 개발에만 쓰인다. APK/EAS 빌드의 주소는
# eas.json 의 프로필 env 또는 워크플로가 정한다(.env 를 덮어쓴다).
EXPO_PUBLIC_API_BASE_URL=https://bridge.kfpa.or.kr
EXPO_PUBLIC_API_TIMEOUT_MS=10000
EXPO_PUBLIC_USE_MOCK_DATA=false
EXPO_PUBLIC_SENTRY_DSN=
