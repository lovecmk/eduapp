# Caddy 리버스 프록시 — API 앞단에서 TLS 종단 + 라우팅.
#
# SITE_ADDRESS 에 도메인을 주면(예: api.example.com) Let's Encrypt 로 인증서를
# 자동 발급·갱신한다. 값이 ":80"(기본)이면 평문으로 사내/로컬 노출.
# 두 경우 모두 컨테이너/코드는 그대로 — 환경변수만 바뀐다(이식성).

{
	# ACME 등록 이메일(도메인 모드에서 만료 알림용). 비어 있어도 발급은 동작.
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# ── 관리 콘솔(Vue) ────────────────────────────────────────────────────────
	# 정적 SPA 를 API 와 **같은 오리진**에 붙인다. 그래야 CORS 설정도, 토큰을
	# 다른 도메인으로 실어 보내는 문제도 생기지 않는다.
	# ADMIN_DIST 가 비면 이 블록은 404 를 낼 뿐 API 동작에는 영향이 없다.
	handle_path /admin/* {
		root * {$ADMIN_DIST:/srv/admin}
		# SPA 히스토리 라우팅 — 새로고침·딥링크가 index.html 로 떨어져야 한다.
		try_files {path} /index.html
		file_server
	}

	# ── API ───────────────────────────────────────────────────────────────────
	# 로케이션(경로) 블록이 `/api` 에서 `/inner/api/v1` 로 바뀌었다. 구형 `/api/*` 도
	# 함께 넘긴다 — 이미 배포된 앱과 운영 스크립트가 그 경로로 부르고 있고,
	# 서버는 두 접두사를 같은 라우트로 처리한다(middleware.APIPrefix).
	#
	# `handle_path` 가 아니라 `handle` 인 점이 중요하다. 경로를 **그대로** 넘겨야
	# 서버가 접두사를 보고 판단할 수 있다(nginx 로 바꿔 쓸 때도 proxy_pass 끝에
	# `/` 를 붙이면 접두사가 잘려 나가므로 붙이지 말 것).
	@api path /inner/api/v1/* /api/*
	handle @api {
		reverse_proxy api:8080 {
			# 관리 대시보드의 실시간 지표는 SSE(text/event-stream)로 흐른다.
			# 기본 버퍼링을 끄지 않으면 응답이 프록시에 고여 화면이 멈춘 것처럼 보인다.
			flush_interval -1
		}
	}

	# 헬스체크 + 나머지는 프록시 그대로 통과(로드밸런서/업타임 모니터용).
	handle {
		reverse_proxy api:8080 {
			health_uri /health
			health_interval 10s
		}
	}
}
