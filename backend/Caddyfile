# Caddy 리버스 프록시 — API 앞단에서 TLS 종단 + 라우팅.
#
# SITE_ADDRESS 에 도메인을 주면(예: api.example.com) Let's Encrypt 로 인증서를
# 자동 발급·갱신한다. 값이 ":80"(기본)이면 평문으로 사내/로컬 노출.
# 두 경우 모두 컨테이너/코드는 그대로 — 환경변수만 바뀐다(이식성).

{
	# ACME 등록 이메일(도메인 모드에서 만료 알림용). 비어 있어도 발급은 동작.
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# 헬스체크는 프록시 그대로 통과(로드밸런서/업타임 모니터용).
	reverse_proxy api:8080 {
		health_uri /health
		health_interval 10s
	}
}
