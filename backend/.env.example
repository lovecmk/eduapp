# eduapp 백엔드 환경변수 예시 — 실제 값은 .env 로 복사해 채운다.

# HTTP
PORT=8080
# 저장소: postgres(운영 권장) | memory(무 DB 로컬/데모/테스트) | mongo(레거시)
STORE=postgres
# 허용 CORS Origin(","로 구분, "*" 가능). 도메인 확정 후엔 앱 오리진으로 좁힐 것.
CORS_ORIGINS=*

# PostgreSQL (STORE=postgres 일 때). 도커 compose 운영 프로파일은 이 값을
# POSTGRES_* 로부터 자동 조립하므로, 단일 바이너리로 직접 붙일 때만 채운다.
DATABASE_URL=postgres://eduapp:eduapp@localhost:5432/eduapp?sslmode=disable

# --- docker compose 운영 프로파일(--profile prod)용 ---
POSTGRES_USER=eduapp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eduapp
# 자동 HTTPS 도메인(비우면 Caddy 가 :80 평문). 예: api.example.com
DOMAIN=
ACME_EMAIL=
# 테스트 프로파일(--profile test) 외부 노출 포트
API_PORT=8080

# MongoDB (STORE=mongo 레거시일 때만)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eduapp

# JWT (운영에서는 반드시 긴 랜덤 문자열로 교체 → `make secret` 로 생성)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TTL=15m
REFRESH_TTL=720h

# 부팅 시 카드 시드/데모 계정 자동 주입
SEED_ON_START=true

# 개인별 1회 학습 세션 목표 시간(초) — 기본 180(3분)
STUDY_SESSION_SEC=180

# --- 원격 푸시(Expo Push) ---
# 비우면 Expo 기본 게이트웨이(https://exp.host/--/api/v2/push/send) 사용.
EXPO_PUSH_URL=

# --- 텔레그램 제어(추후 API 키 주입) ---
# 봇 토큰을 채우면 자동으로 long-polling 이 시작되고 /alert1~3, /help 명령을 처리한다.
# 비워두면 텔레그램 연동은 완전히 비활성(다른 기능에는 영향 없음).
TELEGRAM_BOT_TOKEN=
# 명령 실행을 허용할 chat_id 화이트리스트(","로 구분, 비우면 전체 허용)
TELEGRAM_ALLOWED_CHATS=
# long-polling 자동 시작 여부(기본 true) — 웹훅 방식을 쓸 땐 false 로 두고
# /api/telegram/webhook 에 텔레그램 setWebhook 을 연결한다.
TELEGRAM_POLL=true
# (선택) 테스트/프록시용 텔레그램 API 주소 — 비우면 https://api.telegram.org
TELEGRAM_API_BASE=
