# eduapp 백엔드 환경변수 예시 — 실제 값은 .env 로 복사해 채운다.

# HTTP
PORT=8080
# 저장소: mongo(기본) | memory(무 DB 로컬/데모)
STORE=mongo
# 허용 CORS Origin(","로 구분, "*" 가능)
CORS_ORIGINS=*

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=eduapp

# JWT (운영에서는 반드시 긴 랜덤 문자열로 교체)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TTL=15m
REFRESH_TTL=720h

# 부팅 시 카드 시드/데모 계정 자동 주입
SEED_ON_START=true

# 개인별 1회 학습 세션 목표 시간(초) — 기본 180(3분)
STUDY_SESSION_SEC=180
